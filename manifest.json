{
  "manifest_version": 3,
  "name": "自适应无损比例视频墙",
  "version": "1.0.0",
  "description": "点击任意网页中正在播放的视频，在保持原始宽高比不变的前提下实时同步到自适应多路视频墙并最大化占满屏幕。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "自适应无损比例视频墙",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "extension/popup.html"
  },
  "background": {
    "service_worker": "extension/background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "extension/content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "pick-video": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "点选页面视频并同步到自适应视频墙"
    }
  }
}